# ============================================================
# SPARTON - Development environment
# Copy to .env and adjust. Never commit real .env files.
# ============================================================

# --- Core ---
SPARTON_ENV=development
LOG_LEVEL=INFO
# Public base URL, used for Stripe redirects and email links.
APP_URL=http://localhost:8000

# --- Feature flags -------------------------------------------------------
# Which domains are mounted. A disabled domain has NO routes at all, not
# routes that 403. Defaults to the launched product only.
ENABLED_DOMAINS=intelligence,agent,commerce

# --- Database (PostgreSQL in production; SQLite for local dev/tests) ---
DATABASE_URL=sqlite:///./sparton.db
DB_ECHO=false

# --- Redis (queue transport + distributed rate limiting; optional locally) ---
# REDIS_URL=redis://localhost:6379/0
EMBEDDED_WORKER=true

# --- Auth ---
# Machine principal for server-to-server calls and Prometheus scrapes.
# Leave empty to disable it. There is NO anonymous fallback: an empty value
# does not open the API.
API_KEY=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Enforce email verification (defaults to true when SPARTON_ENV=production).
EMAIL_VERIFICATION_REQUIRED=false

# --- LLM: OpenRouter --------------------------------------------------
# LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# LLM_MODEL_STRONG=anthropic/claude-3.5-sonnet
# LLM_MODEL_CHEAP=google/gemini-2.0-flash-001
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=3
# OPENROUTER_SITE_URL=http://localhost:8000
# OPENROUTER_APP_NAME=Sparton Intelligence

# --- Embeddings (only used by the experimental documents domain) -------
# auto | ollama | sentence-transformers | hash
# "hash" is deterministic and needs no network - this is what tests use.
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=nomic-embed-text
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4

# --- Crawler (competitor tracking) -------------------------------------
CRAWLER_ALLOW_PRIVATE_ADDRESSES=false
CRAWLER_USER_AGENT=SpartonIntelligence/1.0 (+https://sparton.ai/bot)
CRAWLER_MAX_PAGES_PER_SHOP=40

# --- Email (verification + password reset) -----------------------------
# When SMTP_HOST is empty, emails are written to ./data/outbox instead of
# being sent, so local development works with no mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@sparton.ai
SMTP_STARTTLS=true

# --- Billing (Stripe) -------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- Rate limiting ------------------------------------------------------
RATE_LIMIT_DISABLED=false
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_FORGOT_PASSWORD_PER_MINUTE=5
RATE_LIMIT_AGENT_PER_MINUTE=10
RATE_LIMIT_RESEARCH_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# --- Agent runtime ------------------------------------------------------
AGENT_MAX_ITERATIONS=12
AGENT_MAX_TOOL_CALLS=24
AGENT_TIMEOUT_SECONDS=120
MAX_TOOL_RETRIES=2
STRICT_TOOL_GROUNDING=true

# --- Observability ------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sparton-api
SENTRY_DSN=
