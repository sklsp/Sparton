# ============================================================
# SPARTON — Development environment
# Copy to .env and adjust. Never commit real .env files.
# ============================================================

# --- Core ---
SPARTON_ENV=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL in production; SQLite for local dev/tests) ---
DATABASE_URL=sqlite:///./sparton.db
DB_ECHO=false

# --- Redis (queue transport + distributed rate limiting; optional locally) ---
# REDIS_URL=redis://localhost:6379/0
EMBEDDED_WORKER=true

# --- Auth ---
API_KEY=
CORS_ORIGINS=http://localhost:3000

# --- LLM providers ---
LLM_PROVIDER=ollama                # ollama | openai_compatible | test
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_FALLBACK_MODEL=all-MiniLM-L6-v2
OLLAMA_VISION_MODEL=llava
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- RAG (Apollo/Hector) ---
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4

# --- ComfyUI (Apollo generation) ---
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_GENERATION_TIMEOUT=600
COMFYUI_WORKFLOW_DIR=./workflows
COMFYUI_LORA_DIR=

# --- LoRA training (Apollo/Leonidas) ---
AI_TOOLKIT_PATH=
AI_TOOLKIT_PYTHON=

# --- Storage paths ---
DATA_DIR=./data
LORA_DATA_DIR=./data/loras
GENERATED_DIR=./data/generated
MODEL_DIR=
MAX_IMAGE_UPLOAD_MB=25

# --- Crawler / research (Odysseus) ---
CRAWLER_ALLOW_PRIVATE_ADDRESSES=false

# --- Rate limiting ---
RATE_LIMIT_DISABLED=false
RATE_LIMIT_AGENT_PER_MINUTE=10
RATE_LIMIT_RESEARCH_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_MINUTE=20

# --- Agent runtime (Athena) ---
AGENT_MAX_ITERATIONS=12
AGENT_MAX_TOOL_CALLS=24
AGENT_TIMEOUT_SECONDS=120
MAX_TOOL_RETRIES=2
STRICT_TOOL_GROUNDING=true

# --- Observability ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sparton-api
