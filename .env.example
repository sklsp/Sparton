# ============================================================
# SPARTON - Development environment
# Copy to .env and adjust. Never commit real .env files.
# ============================================================

# --- Core ---
SPARTON_ENV=development
LOG_LEVEL=INFO
# Public base URL, used for Stripe redirects and email links.
APP_URL=http://localhost:8000

# --- Feature flags -------------------------------------------------------
# Which domains are mounted. A disabled domain has NO routes at all, not
# routes that 403. Defaults to the launched product only.
ENABLED_DOMAINS=intelligence,agent,commerce

# --- Database (PostgreSQL in production; SQLite for local dev/tests) ---
DATABASE_URL=sqlite:///./sparton.db
DB_ECHO=false

# --- Redis (queue transport + distributed rate limiting; optional locally) ---
# # Peers allowed to set X-Forwarded-For. Must match uvicorn --forwarded-allow-ips.
# Never '*'. Default is loopback only.
FORWARDED_ALLOW_IPS=127.0.0.1

REDIS_URL=redis://localhost:6379/0
EMBEDDED_WORKER=true

# --- Auth ---
# Machine principal for server-to-server calls and Prometheus scrapes.
# Leave empty to disable it. There is NO anonymous fallback: an empty value
# does not open the API.
API_KEY=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Enforce email verification (defaults to true when SPARTON_ENV=production).
EMAIL_VERIFICATION_REQUIRED=false

# --- LLM: OpenRouter --------------------------------------------------
# LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# LLM_MODEL_STRONG=anthropic/claude-sonnet-4.6
# LLM_MODEL_CHEAP=google/gemini-3.5-flash-lite
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=3
# LLM_RETRY_BASE_SECONDS=1
# LLM_RETRY_CAP_SECONDS=30
# OpenRouter attribution headers (required by their terms; used for the leaderboard)
# OPENROUTER_SITE_URL=http://localhost:8000
# OPENROUTER_APP_NAME=Sparton Intelligence

# --- Embeddings (only used by the experimental documents domain) -------
# auto | ollama | sentence-transformers | hash
# "hash" is deterministic and needs no network - this is what tests use.
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=nomic-embed-text
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4

# --- Crawler (competitor tracking) -------------------------------------
CRAWLER_ALLOW_PRIVATE_ADDRESSES=false
CRAWLER_USER_AGENT=SpartonIntelligence/1.0 (+https://sparton.ai/bot)
CRAWLER_MAX_PAGES_PER_SHOP=40

# --- Email (verification + password reset) -----------------------------
# When SMTP_HOST is empty, emails are written to ./data/outbox instead of
# being sent, so local development works with no mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@sparton.ai
SMTP_STARTTLS=true

# --- Billing (Stripe) -------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- Rate limiting ------------------------------------------------------
RATE_LIMIT_DISABLED=false
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_FORGOT_PASSWORD_PER_MINUTE=5
RATE_LIMIT_AGENT_PER_MINUTE=10
RATE_LIMIT_RESEARCH_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# --- Agent runtime ------------------------------------------------------
AGENT_MAX_ITERATIONS=12
AGENT_MAX_TOOL_CALLS=24
AGENT_TIMEOUT_SECONDS=120
MAX_TOOL_RETRIES=2
STRICT_TOOL_GROUNDING=true

# --- Observability ------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sparton-api
SENTRY_DSN=

# --- Production switches ------------------------------------------------
# These are the ones an operator actually has to decide about. Everything
# above has a safe default; these change what the service will do.

# `production` turns on the email-verification gate and the strict auth checks.
# Running `development` in production leaves the gate off, which is exactly
# the kind of mistake that is invisible until someone signs up.
SPARTON_ENV=development

# POSTGRES_PASSWORD has no default on purpose: docker-compose.yml refuses to
# start without it rather than booting a database anyone on the network can
# reach. Generate one with: openssl rand -base64 32
POSTGRES_USER=sparton
POSTGRES_PASSWORD=
POSTGRES_DB=sparton

# Public URL of the deployment. Used for CORS, OpenRouter attribution, and the
# links inside verification and password-reset emails — if this is wrong, the
# reset link in a customer's inbox points nowhere.
APP_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Where the queue and rate limits live. Leave blank to run both in-process,
# which is fine for one container but not for more than one.
REDIS_URL=

# Set false to run the app with the billing screens present but inert, e.g.
# before Stripe keys exist. Plan limits still apply.
BILLING_ENABLED=true

# How long a session token stays valid. A reset revokes every session
# regardless of this; it only controls normal expiry.
AUTH_TOKEN_TTL_MINUTES=1440

# How many competitor suggestions a single discover call may return.
COMPETITOR_DISCOVERY_LIMIT=5
# Leave false: we never add a competitor the customer has not confirmed.
COMPETITOR_DISCOVERY_AUTO_ADD=false
