# ============================================================
# SPARTON — Production environment template
# Copy to .env.production, fill every secret, never commit it.
# ============================================================

SPARTON_ENV=production
LOG_LEVEL=WARNING

# --- Database (REQUIRED: PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://sparton:<DB_PASSWORD>@postgres:5432/sparton
DB_ECHO=false

# --- Redis (REQUIRED in production for distributed queue + rate limiting) ---
REDIS_URL=redis://redis:6379/0
EMBEDDED_WORKER=false

# --- Auth (REQUIRED) ---
API_KEY=<generate-a-long-random-secret>
CORS_ORIGINS=https://sparton.example.com

# --- LLM providers ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# --- RAG ---
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4

# --- ComfyUI ---
COMFYUI_BASE_URL=http://comfyui:8188
COMFYUI_GENERATION_TIMEOUT=600

# --- LoRA training ---
AI_TOOLKIT_PATH=/models/ai-toolkit
AI_TOOLKIT_PYTHON=/usr/bin/python3

# --- Storage paths (shared volumes) ---
DATA_DIR=/data
LORA_DATA_DIR=/data/loras
GENERATED_DIR=/data/generated
MODEL_DIR=/models
MAX_IMAGE_UPLOAD_MB=25

# --- Crawler / research ---
CRAWLER_ALLOW_PRIVATE_ADDRESSES=false

# --- Rate limiting ---
RATE_LIMIT_DISABLED=false
RATE_LIMIT_AGENT_PER_MINUTE=10
RATE_LIMIT_RESEARCH_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_MINUTE=20

# --- Agent runtime ---
AGENT_MAX_ITERATIONS=12
AGENT_MAX_TOOL_CALLS=24
AGENT_TIMEOUT_SECONDS=120
MAX_TOOL_RETRIES=2
STRICT_TOOL_GROUNDING=true

# --- Observability ---
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_SERVICE_NAME=sparton-api
